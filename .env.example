# Database (use sqlite for local dev, postgresql for production)
# Neon example: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/healthcare

# JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI
GEMINI_API_KEY=your-gemini-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# App
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
