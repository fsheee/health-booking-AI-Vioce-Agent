# Database
DATABASE_URL=postgresql://user:password@localhost:5432/healthcare

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI / Voice
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# SMTP / Email (optional — leave empty to skip emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@healthcare-clinic.com
SMTP_FROM_NAME=Healthcare Clinic
SMTP_USE_TLS=true

# App
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# On Vercel, set this to your frontend's Vercel URL (e.g. my-app.vercel.app)
VERCEL_FRONTEND_URL=
